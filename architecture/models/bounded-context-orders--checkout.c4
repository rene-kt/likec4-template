model {
  extend orders {
    checkout = system 'Checkout' {
      description 'Conduz a jornada de compra até a criação do pedido.'
      style {
        color bc-checkout
      }

      checkout_web = webapp 'Página de Checkout' {
        description 'Interface usada pelo cliente para revisar e confirmar a compra.'
      }

      checkout_api = service 'API de Checkout' {
        description 'Valida a solicitação e encaminha a criação do pedido.'
        technology 'PHP'
        icon tech:php
        style {
          color amber
        }

        checkout_controller = component 'Controlador de Checkout' {
          description 'Recebe a confirmação de compra e inicia o processamento.'
        }

        checkout_application = component 'Aplicação de Checkout' {
          description 'Coordena a validação e a solicitação de criação do pedido.'

          create_order = code 'CreateOrderHandler' {
            description 'Conduz a criação de um pedido no exemplo.'
          }

          validate_order = code 'OrderValidator' {
            description 'Verifica os dados enviados pelo cliente.'
          }

          build_command = code 'CreateOrderCommand' {
            description 'Representa os dados necessários para criar o pedido.'
          }
        }
      }
    }
  }
}
