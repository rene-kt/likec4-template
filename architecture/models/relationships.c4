model {
  customer -[https]-> account.account_web 'Abre a área da conta'
  account.account_web -[https]-> account.account_api 'Envia os dados da conta'
  account.account_api -> account.account_db 'Grava a conta'
  customer -[https]-> orders.checkout.checkout_web 'Inicia a compra'
  orders.checkout.checkout_web -[https]-> catalog.catalog_api 'Consulta os itens'
  catalog.catalog_api -> catalog.catalog_db 'Lê os itens'
  orders.checkout.checkout_web -[https]-> orders.checkout.checkout_api 'Confirma o pedido'
  orders.checkout.checkout_api -[https]-> orders.orders_api 'Solicita a criação'
  orders.checkout.checkout_api.checkout_controller -> orders.checkout.checkout_api.checkout_application 'Inicia a criação'
  orders.checkout.checkout_api.checkout_application -> orders.orders_api 'Solicita o pedido'
  orders.checkout.checkout_api.checkout_application.create_order -> orders.checkout.checkout_api.checkout_application.validate_order 'Valida os dados'
  orders.checkout.checkout_api.checkout_application.create_order -> orders.checkout.checkout_api.checkout_application.build_command 'Monta o comando'
  orders.orders_api -> orders.orders_db 'Grava o pedido'
  orders.orders_api -[https]-> payments.purchase.payment_api 'Solicita pagamento'
  customer -[https]-> payments.purchase.payment_web 'Confirma o pagamento'
  payments.purchase.payment_web -[https]-> payments.purchase.payment_api 'Envia os dados do pagamento'
  payments.purchase.payment_api -[https]-> account.account_api 'Consulta a conta'
  payments.purchase.payment_api -[https]-> payments.processor.processor_adapter 'Solicita processamento'
  payments.processor.processor_adapter -[async]-> payments.processor.processor_events 'Publica o resultado'
  payments.processor.processor_events -[async]-> payments.purchase.payment_api 'Entrega o resultado'
  payments.purchase.payment_api -> payments.purchase.payment_db 'Registra o resultado'
  orders.orders_api -[async]-> notifications.order_events 'Publica pedido criado'
  notifications.order_events -[async]-> notifications.notification_worker 'Entrega o evento'

  // Cenário ilustrativo de estresse: chamadas de volta entre pares existentes.
  account.account_api -[callback]-> account.account_web 'Solicita atualização da interface'
  catalog.catalog_api -[callback]-> orders.checkout.checkout_web 'Atualiza itens disponíveis'
  catalog.catalog_db -[callback]-> catalog.catalog_api 'Informa alteração no catálogo'
  orders.checkout.checkout_api -[callback]-> orders.checkout.checkout_web 'Atualiza o estado do checkout'
  orders.orders_api -[callback]-> orders.checkout.checkout_api 'Confirma a criação do pedido'
  orders.checkout.checkout_api.checkout_application -[callback]-> orders.checkout.checkout_api.checkout_controller 'Devolve o resultado da criação'
  orders.orders_api -[callback]-> orders.checkout.checkout_api.checkout_application 'Devolve o identificador do pedido'
  orders.checkout.checkout_api.checkout_application.validate_order -[callback]-> orders.checkout.checkout_api.checkout_application.create_order 'Devolve a validação'
  orders.checkout.checkout_api.checkout_application.build_command -[callback]-> orders.checkout.checkout_api.checkout_application.create_order 'Devolve o comando'
  orders.orders_db -[callback]-> orders.orders_api 'Confirma a gravação do pedido'
  payments.purchase.payment_api -[callback]-> orders.orders_api 'Devolve o estado do pagamento'
  payments.purchase.payment_api -[callback]-> payments.purchase.payment_web 'Atualiza o estado do pagamento'
  account.account_api -[callback]-> payments.purchase.payment_api 'Devolve os dados da conta'
  payments.processor.processor_adapter -[callback]-> payments.purchase.payment_api 'Devolve a autorização'
  payments.processor.processor_events -[callback]-> payments.processor.processor_adapter 'Confirma a publicação do resultado'
  payments.purchase.payment_api -[callback]-> payments.processor.processor_events 'Confirma o recebimento do resultado'
  payments.purchase.payment_db -[callback]-> payments.purchase.payment_api 'Confirma o registro do resultado'
  notifications.order_events -[callback]-> orders.orders_api 'Confirma a publicação do pedido'
  notifications.notification_worker -[callback]-> notifications.order_events 'Confirma o processamento do evento'
  account.account_api -[callback]-> customer 'Informa alteração da conta'
  orders.orders_api -[callback]-> customer 'Informa criação do pedido'
  payments.purchase.payment_api -[callback]-> customer 'Informa confirmação do pagamento'

  // Novas chamadas cruzadas em ambos os sentidos.
  orders.orders_api -[https]-> catalog.catalog_api 'Consulta disponibilidade para o pedido'
  catalog.catalog_api -[callback]-> orders.orders_api 'Atualiza disponibilidade do pedido'
  orders.orders_api -[https]-> account.account_api 'Consulta dados para o pedido'
  account.account_api -[callback]-> orders.orders_api 'Atualiza dados do cliente no pedido'
  orders.checkout.checkout_api -[https]-> payments.purchase.payment_api 'Consulta opções de pagamento'
  payments.purchase.payment_api -[callback]-> orders.checkout.checkout_api 'Atualiza opções de pagamento'
  payments.purchase.payment_api -[https]-> catalog.catalog_api 'Consulta preço dos itens'
  catalog.catalog_api -[callback]-> payments.purchase.payment_api 'Atualiza preço dos itens'
  notifications.notification_worker -[https]-> account.account_api 'Consulta contato do cliente'
  account.account_api -[callback]-> notifications.notification_worker 'Atualiza contato para notificação'
  notifications.notification_worker -[https]-> payments.purchase.payment_api 'Consulta estado do pagamento'
  payments.purchase.payment_api -[callback]-> notifications.notification_worker 'Atualiza estado para notificação'
  payments.processor.processor_adapter -[https]-> account.account_api 'Consulta dados para autorização'
  account.account_api -[callback]-> payments.processor.processor_adapter 'Atualiza dados para autorização'
  orders.checkout.checkout_web -[https]-> payments.purchase.payment_web 'Abre confirmação de pagamento'
  payments.purchase.payment_web -[callback]-> orders.checkout.checkout_web 'Retorna ao checkout'
  orders.checkout.checkout_api -[https]-> catalog.catalog_api 'Consulta itens do checkout'
  catalog.catalog_api -[callback]-> orders.checkout.checkout_api 'Atualiza itens do checkout'
  orders.orders_api -[https]-> payments.processor.processor_adapter 'Consulta processamento do pedido'
  payments.processor.processor_adapter -[callback]-> orders.orders_api 'Atualiza processamento do pedido'

  // Múltiplas relações distintas para os mesmos pares.
  orders.orders_api -[https]-> catalog.catalog_api 'Reserva itens do pedido'
  catalog.catalog_api -[callback]-> orders.orders_api 'Confirma reserva dos itens'
  orders.checkout.checkout_api -[https]-> payments.purchase.payment_api 'Valida forma de pagamento'
  payments.purchase.payment_api -[callback]-> orders.checkout.checkout_api 'Informa validade da forma de pagamento'
  orders.orders_api -[https]-> account.account_api 'Consulta histórico de compras'
  account.account_api -[callback]-> orders.orders_api 'Atualiza perfil de compras'
}
