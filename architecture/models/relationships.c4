model {
  customer -[https]-> orders.checkout.checkout_web 'Inicia a compra'
  orders.checkout.checkout_web -[https]-> catalog.catalog_api 'Consulta os itens'
  catalog.catalog_api -> catalog.catalog_db 'Lê os itens'
  orders.checkout.checkout_web -[https]-> orders.checkout.checkout_api 'Confirma o pedido'
  orders.checkout.checkout_api -[https]-> orders.orders_api 'Solicita a criação'
  orders.checkout.checkout_api.checkout_controller -> orders.checkout.checkout_api.checkout_application 'Inicia a criação'
  orders.checkout.checkout_api.checkout_application -> orders.orders_api 'Solicita o pedido'
  orders.checkout.checkout_api.checkout_application.create_order -> orders.checkout.checkout_api.checkout_application.validate_order 'Valida os dados'
  orders.checkout.checkout_api.checkout_application.create_order -> orders.checkout.checkout_api.checkout_application.build_command 'Monta o comando'
  orders.orders_api -> orders.orders_db 'Grava o pedido'
  orders.orders_api -[async]-> notifications.order_events 'Publica pedido criado'
  notifications.order_events -[async]-> notifications.notification_worker 'Entrega o evento'
}
